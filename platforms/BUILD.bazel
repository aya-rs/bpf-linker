# rules_rs requires an explicit Windows ABI; use MSVC to match prebuilt rustc.
# TODO: Remove this platform when rules_rs selects MSVC for Windows hosts
# without an explicit ABI constraint.
platform(
    name = "local_windows_msvc",
    constraint_values = [
        "@llvm//constraints/windows/abi:msvc",
    ],
    parents = ["@platforms//host"],
)
