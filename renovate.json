{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["schedule:monthly"],
  "enabledManagers": ["bazel-module", "cargo", "github-actions"],
  "separateMajorMinor": false,
  "packageRules": [
    {
      "description": [
        "Mend enabled bazelModDeps for aya-rs, so Renovate refreshes MODULE.bazel.lock when it updates a Bazel dependency.",
        "https://github.com/renovatebot/renovate/discussions/47308#discussioncomment-19198981"
      ],
      "matchManagers": ["bazel-module"],
      "groupName": "bazel-modules"
    },
    {
      "matchManagers": ["cargo"],
      "minimumReleaseAge": "3 days",
      "groupName": "cargo-crates"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["llvm-sys"],
      "rangeStrategy": "in-range-only"
    },
    {
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": "3 days",
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["workflow"],
      "matchPackageNames": ["aya-rs/aya"],
      "minimumReleaseAge": null
    }
  ]
}
